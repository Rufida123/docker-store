# Chain: the app's own account is checked by RabbitMQ itself (internal);
# every other login (a browser) is checked by Laravel (http).
auth_backends.1 = internal
auth_backends.2 = http

auth_http.http_method   = post
auth_http.user_path     = http://backend:3001/api/v1/internal/rabbitmq/auth/user
auth_http.vhost_path    = http://backend:3001/api/v1/internal/rabbitmq/auth/vhost
auth_http.resource_path = http://backend:3001/api/v1/internal/rabbitmq/auth/resource
auth_http.topic_path    = http://backend:3001/api/v1/internal/rabbitmq/auth/topic

web_stomp.tcp.port = 15674