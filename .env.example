POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=appdb

JWT_SECRET=generate_with_openssl_rand_-hex_64
JWT_EXPIRES_IN=15m
PORT=3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345

# Firebase push notifications (optional). Leave empty to run without push.
# Web app config: Firebase console > Project settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Project settings > Cloud Messaging > Web Push certificates > Key pair
VITE_FIREBASE_VAPID_KEY=
# The server key is a FILE, not a variable: secrets/firebase-service-account.json
